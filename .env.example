# Private /traces dashboard. Not linked from the public chat.
# OBSERVABILITY_TOKEN=

# Guard model (Llama-Guard-style classifier via a small OpenAI model)
# GUARD_MODEL_ENABLED=1
# GUARD_MODEL=gpt-4o-mini

