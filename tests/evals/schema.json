{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/arslanoqads/arslan-agent-service/tests/evals/schema.json",
  "title": "Golden case",
  "version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "family", "input", "expected_tool", "oracle", "severity", "source"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "family": {"type": "string", "enum": ["POS", "NEAR", "NEG"]},
    "input": {"type": "string", "minLength": 1},
    "expected_tool": {"type": "string"},
    "must_include": {"type": "array", "items": {"type": "string"}},
    "must_not_include": {"type": "array", "items": {"type": "string"}},
    "oracle": {"type": "string", "enum": ["code", "regex", "exact"]},
    "severity": {"type": "string", "enum": ["blocker", "major"]},
    "source": {"type": "string", "enum": ["synthetic", "production"]}
  }
}
